# App
NEXT_PUBLIC_APP_URL=https://juryhour.com
APP_MODE=live            # live | sandbox
OPS_API_KEY=             # bearer key agents use to call /api/ops/*
INTERNAL_CRON_SECRET=    # pg_cron -> /api/reconcile auth
OPS_BASIC_AUTH_USER=     # /ops dashboard login
OPS_BASIC_AUTH_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=          # scripts only (migrations, cron setup)

# Whop
WHOP_API_KEY=
WHOP_SANDBOX_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_SANDBOX_WEBHOOK_SECRET=
WHOP_COMPANY_ID=         # biz_...
WHOP_SANDBOX_COMPANY_ID= # biz_... (sandbox business)
WHOP_API_VERSION_DATE=2026-07-01

# Terac
TERAC_API_KEY=
TERAC_PROJECT_ID=
TERAC_WEBHOOK_SECRET=

# Exa
EXA_API_KEY=

# OpenAI (preview, safety screen, juror grading)
OPENAI_API_KEY=

# Claude Code cloud scheduled tasks with API triggers (claude.ai/code/routines)
AGENT_RESEARCHER_FIRE_URL=
AGENT_RESEARCHER_FIRE_TOKEN=
AGENT_ANALYST_FIRE_URL=
AGENT_ANALYST_FIRE_TOKEN=
AGENT_PROCUREMENT_FIRE_URL=
AGENT_PROCUREMENT_FIRE_TOKEN=
AGENT_DISPUTES_FIRE_URL=
AGENT_DISPUTES_FIRE_TOKEN=
AGENT_SUPPORT_FIRE_URL=
AGENT_SUPPORT_FIRE_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM="JuryHour <verdict@juryhour.com>"

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Website (docs/WEBSITE_SPEC.md)
LAUNCH_OFFER_ENDS_AT=        # ISO end time, e.g. 2026-10-24T22:00:00Z
LAUNCH_OFFER_TIER=proof
LAUNCH_OFFER_PRICE=99
